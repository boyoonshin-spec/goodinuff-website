DATABASE_URL="file:./prisma/dev.db"

# NextAuth — generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Kakao Developers app (https://developers.kakao.com)
# 1. 애플리케이션 추가 후 REST API 키를 복사
# 2. 카카오 로그인 활성화 → Redirect URI에 아래 KAKAO_REDIRECT_URI 값 등록
# 3. 카카오 로그인 > 동의항목에서 "카카오톡 메시지 전송" 활성화
# 4. (개발 단계에서는) 카카오 개발자 콘솔 > 팀 관리에서 사용할 카카오 계정을 팀원으로 추가
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:3000/api/kakao/callback"

# Used to build the link inside Kakao messages; update after deploying
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared secret required as a bearer token to call /api/cron/send-reminders
CRON_SECRET=""
